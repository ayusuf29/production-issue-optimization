            {
              "key": "size",
              "value": "20",
              "description": "Page size (default: 20)"
            }
          ]
        },
        "description": "Retrieves orders using standard SQL offset pagination (Page<OrderSummaryResponse>)."
      },
      "response": []
    },
    {
      "name": "Get Orders - Keyset Pagination (First Page)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/orders/keyset?size=20",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "orders",
            "keyset"
          ],
          "query": [
            {
              "key": "cursor",
              "value": "",
              "disabled": true,
              "description": "Base64 cursor from previous page (omit for first page)"
            },
            {
              "key": "size",
              "value": "20",
              "description": "Page size (default: 20)"
            }
          ]
        },
        "description": "Retrieves the first page using cursor/keyset pagination (CursorResponse<OrderSummaryResponse>)."
      },
      "response": []
    },
    {
      "name": "Get Orders - Keyset Pagination (Next Page with Cursor)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/orders/keyset?cursor={{nextCursor}}&size=20",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "orders",
            "keyset"
          ],
          "query": [
            {
              "key": "cursor",
              "value": "{{nextCursor}}",
