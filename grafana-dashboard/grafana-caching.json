                    },
                    "group": "prometheus",
                    "kind": "DataQuery",
                    "spec": {
                      "editorMode": "code",
                      "expr": "sum(rate(cache_gets_total{result=\"hit\"}[15s])) or sum(rate(cache_gets_total{result=\"hit\"}[30s]))",
