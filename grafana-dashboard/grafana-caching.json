                      "name": "prometheus"
                    },
                    "group": "prometheus",
                    "kind": "DataQuery",
                    "spec": {
                      "editorMode": "code",
                      "expr": "sum(rate(cache_gets_total{result=\"miss\"}[15s])) or sum(rate(cache_gets_total{result=\"miss\"}[30s]))",
                      "legendFormat": "Cache Misses (DB Load Triggered)",
                      "range": true
