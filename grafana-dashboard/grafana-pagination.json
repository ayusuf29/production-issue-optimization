    "panel-1": {
      "kind": "Panel",
      "spec": {
        "data": {
          "kind": "QueryGroup",
          "spec": {
            "queries": [
              {
                "kind": "PanelQuery",
                "spec": {
                  "hidden": false,
                  "query": {
                    "datasource": {
                      "name": "prometheus"
                    },
                    "group": "prometheus",
                    "kind": "DataQuery",
                    "spec": {
                      "editorMode": "code",
                      "expr": "(sum(rate(otel_postgresql_blocks_read_total[30s])) or (sum(rate(otel_postgresql_blks_hit_total[30s])) + sum(rate(otel_postgresql_blks_read_total[30s])))) / clamp_min(sum(rate(otel_postgresql_tup_fetched_total[30s])) or sum(rate(otel_postgresql_tup_returned_total[30s])) or sum(rate(http_server_requests_seconds_count{uri=~\"/api/orders.*\"}[30s])), 1)",
                      "legendFormat": "Read Amplification Factor",
                      "range": true
                    },
                    "version": "v0"
                  },
                  "refId": "A"
                }
              }
            ],
            "queryOptions": {},
            "transformations": []
          }
        },
        "description": "Measures physical buffer churn. Keyset should remain flat (~2-4 blocks/row), while deep offset climbs into hundreds/thousands.",
        "id": 1,
        "links": [],
        "title": "PostgreSQL: Read Amplification (Blocks Read per Live Row Fetched)",
        "vizConfig": {
          "group": "timeseries",
          "kind": "VizConfig",
          "spec": {
            "fieldConfig": {
              "defaults": {
